# ─── Required ────────────────────────────────────────────────────────────────

# Your Arcade API key — https://app.arcade.dev/settings
ARCADE_API_KEY=arc_...

# The identity the OAuth grants attach to. Use YOUR OWN Google address, the same
# one you run `npm run seed` against. The fake rescue data lives in your account,
# never a shared one.
#
# This key and this id are used for exactly two things: polling Gmail for new
# applications, and running the pre-authorization flows. The agent never sees
# either — its identity comes from the gateway's own OAuth flow.
ARCADE_USER_ID=you@gmail.com

# Model credentials. Anthropic wins if both are set.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...


# ─── Recommended ─────────────────────────────────────────────────────────────

# The Slack channel the agent posts to. Make your own so your team's output
# isn't buried under everyone else's, and make sure every teammate who runs the
# agent JOINS it — Arcade posts as you, and you can't post to a channel you're
# not in.
SLACK_CHANNEL=adoptions-yourteam


# ─── Optional ────────────────────────────────────────────────────────────────

# Prefills the gateway URL box in the UI. The gateway is normally pasted in at
# runtime (that's a step you watch happen), so this is a convenience for
# rehearsals. Once you've used a gateway it's remembered in .arcade-gateway.
# ARCADE_GATEWAY_URL=https://api.arcade.dev/mcp/gw_xxxxxxxx

# How this MCP client authenticates TO the gateway. Leave it alone.
#   oauth   — the default. Your gateway should be set to "Members of this
#             Project (Arcade Auth)" in the dashboard.
#   headers — sends the Arcade API key on the transport instead. It works, but
#             it puts a long-lived key on the wire and skips the OAuth flow that
#             this demo exists to show. Escape hatch only.
# GATEWAY_AUTH=oauth

# How often to check the mailbox, in milliseconds. Ten seconds is slow enough to
# be honest on stage and fast enough not to feel broken.
# POLL_MS=10000

# PORT=4111
# FOSTER_PORT=4112
# MODEL=anthropic/claude-sonnet-5
